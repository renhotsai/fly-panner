# ── Duffel (Flight Offers) ────────────────────────────────────────────
# Register at https://duffel.com — search is free, booking charges $3 + 1%
# Use a Test token (duffel_test_...) for sandbox, Live token for real data
DUFFEL_API_KEY=duffel_test_xxxxxxxxxxxx

# ── Database (PostgreSQL via Neon) ────────────────────────────────────
# 1. Create a free DB at https://neon.tech
# 2. Copy the "Connection string" (pooled) as DATABASE_URL
# 3. Copy the "Direct connection" string as DIRECT_URL
DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"

# ── Email (Resend) ────────────────────────────────────────────────────
# Get a free key at https://resend.com/
RESEND_API_KEY=re_xxxxxxxxxxxx
# The "from" address — must be a verified domain on Resend
RESEND_FROM=alerts@yourdomain.com

# ── Cron protection ───────────────────────────────────────────────────
# Any random secret; Vercel Cron sends it as "Authorization: Bearer <secret>"
# You can also pass ?secret=xxx manually for testing
CRON_SECRET=change_me_to_a_random_string

# ── App base URL ──────────────────────────────────────────────────────
# Set to your Vercel domain in production, e.g. https://fly-panner.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000
