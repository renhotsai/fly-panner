# ── Amadeus API ───────────────────────────────────────────────────────
# Get a free key at https://developers.amadeus.com/
AMADEUS_API_KEY=your_api_key_here
AMADEUS_API_SECRET=your_api_secret_here

# ── Database (SQLite) ─────────────────────────────────────────────────
DATABASE_URL="file:../prisma/dev.db"

# ── Email (Resend) ────────────────────────────────────────────────────
# Get a free key at https://resend.com/
RESEND_API_KEY=re_xxxxxxxxxxxx
# The "from" address — must be a verified domain on Resend
RESEND_FROM=alerts@yourdomain.com

# ── Cron protection ───────────────────────────────────────────────────
# Any random secret; pass as ?secret=xxx when calling /api/cron/send-alerts
CRON_SECRET=change_me_to_a_random_string

# ── App base URL ──────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
